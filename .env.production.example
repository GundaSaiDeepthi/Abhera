# ==============================================================================
# ABHERA Production Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Environment Variables (Configure in Render Web Service Dashboard)
# ------------------------------------------------------------------------------
# Database: Supabase PostgreSQL Connection String (Transaction Pooler or Direct)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.your-project-id:your-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# CORS Configuration: Whitelist your deployed Vercel frontend URL
CORS_ORIGINS=["https://your-app.vercel.app","http://localhost:5173"]

# Application Runtime Configuration
PORT=8000
ENVIRONMENT=production
DEBUG=False

# ------------------------------------------------------------------------------
# Frontend Environment Variables (Configure in Vercel Project Settings)
# ------------------------------------------------------------------------------
# Public HTTPS URL of the deployed FastAPI Backend on Render
VITE_API_URL=https://abhera-backend.onrender.com
